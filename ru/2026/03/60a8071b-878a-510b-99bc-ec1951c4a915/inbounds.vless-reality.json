{
  "port": 443,
  "protocol": "vless",
  "tag": "in-443-tcp",
  "sniffing": {
    "enabled": true,
    "destOverride": [
      "http",
      "tls",
      "quic",
      "fakedns"
    ]
  },
  "streamSettings": {
    "network": "tcp",
    "security": "reality",
    "tcpSettings": {
      "acceptProxyProtocol": false,
      "header": {
        "type": "none"
      }
    },
    "realitySettings": {
      "show": false,
      "xver": 0,
      "target": "www.microsoft.com:443",
      "serverNames": [
        "www.microsoft.com"
      ],
      "maxTimediff": 0,
      "settings": {
        "fingerprint": "firefox"
      }
    }
  }
}
